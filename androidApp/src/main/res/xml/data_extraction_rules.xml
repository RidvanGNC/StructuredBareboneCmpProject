<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the encrypted secrets are useless without the device-bound Keystore key. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_store.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_store.xml" />
    </device-transfer>
</data-extraction-rules>
