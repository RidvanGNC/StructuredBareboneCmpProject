<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MSAL'in interaktif giris icin acacagi Custom Tab'dan gelen yonlendirmeyi yakalar.
             android:path degeri msal_config.json'daki redirect_uri'nin imza hash'iyle birebir
             eslesmelidir (su an yerel debug keystore'dan uretildi, bkz. data/androidMain/res/raw/msal_config.json). -->
        <activity
            android:exported="true"
            android:name="com.microsoft.identity.client.BrowserTabActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="msauth"
                    android:host="org.structured_barebone.cmp_project"
                    android:path="/M3FsndsOOv18Ngi%2Fgds7nmrd2%2Bc%3D" />
            </intent-filter>
        </activity>

        <!-- Ek belge indirme/gorunutuleme icin (bkz. AttachmentSaver.android.kt) - indirilen dosya
             cache/attachments altina yazilir ve baska bir uygulamaya content:// URI'si olarak paylasilir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>