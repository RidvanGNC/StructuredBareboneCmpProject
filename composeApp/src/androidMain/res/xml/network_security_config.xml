<?xml version="1.0" encoding="utf-8"?>
<!-- Sadece gelistirme backend adresleri icin cleartext (HTTP) izni: emulator loopback (10.0.2.2)
     ve gercek cihazdan test icin PC'nin LAN IP'si. Gercek production adresleri olmadigindan
     uygulamanin genel guvenlik durumunu zayiflatmaz. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.12</domain>
    </domain-config>
</network-security-config>
